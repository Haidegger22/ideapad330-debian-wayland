# Пример обмена F-ряда и мультимедиа через keyd (когда в BIOS нет Hotkey Mode).
# Кладётся как /etc/keyd/default.conf, затем: systemctl restart keyd
#
# ВАЖНО (проверено на практике): F-ряд НЕОДНОРОДЕН. Часть клавиш прошивка отдаёт
# как мультимедиа (mute, volumedown, brightnessdown), а часть — уже как функциональные
# (f4, f5, f6, f8). Если поменять местами всё подряд, работавшие клавиши сломаются:
# пользователь увидит «ряд F1–F12 пропал совсем».
#
# Поэтому сначала ИЗМЕРИТЬ, потом писать конфиг:
#   1) keyd monitor   (нужен root: у пользователя нет доступа к /dev/input)
#      удобно через systemd-юнит от root, пишущий в файл:
#      ExecStart=/bin/bash -c 'timeout 280 /usr/bin/keyd monitor > /tmp/key.log 2>&1; chmod 644 /tmp/key.log'
#   2) попросить нажать каждую клавишу дважды: обычно и с Fn;
#   3) в логе видно, что приходит. Записи вида "keyd virtual keyboard ... f4" означают,
#      что клавиша УЖЕ даёт F4 — её трогать нельзя.
#   Внимание: монитор показывает уже виртуальную клавиатуру keyd, то есть результат ПОСЛЕ маппинга.
#   4) яркость приходит не с клавиатуры, а с устройства Video Bus — поэтому [ids] нужен «*».
#   5) имена клавиш сверять только через: keyd list-keys
#
# Пример для IdeaPad 330-15ARR: инвертированы были только F1–F3, F7 и F11–F12.

[ids]
*

[main]
# обычное нажатие: мультимедиа-код -> функциональная клавиша
mute = f1
volumedown = f2
volumeup = f3
wlan = f7
rfkill = f7
brightnessdown = f11
brightnessup = f12

# Fn + клавиша: функциональный код -> мультимедийная функция
f1 = mute
f2 = volumedown
f3 = volumeup
f7 = rfkill
f11 = brightnessdown
f12 = brightnessup

# Нельзя переделать: если прошивка посылает готовое сочетание (у IdeaPad 330
# F9 = Super+L, F10 = Super+P), его не превратить в F9/F10 — функции сохранятся,
# но F-клавишами эти кнопки не станут. Лучший путь — Hotkey Mode в BIOS.
